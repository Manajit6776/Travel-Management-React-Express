# ============================================================
# TMS - MREN Stack Monorepo .gitignore
# ============================================================

# ─── Dependencies ───────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Environment Variables ──────────────────────────────────
# Keep .env.example but ignore real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Build Outputs ──────────────────────────────────────────
dist/
build/
out/

# ─── Uploads / User-generated files ─────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ─── Logs ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Runtime / OS ───────────────────────────────────────────
.DS_Store
Thumbs.db
*.tmp
*.swp
*.swo

# ─── Editor & IDE ───────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ─── Testing ────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Vite / Frontend ────────────────────────────────────────
frontend/.vite/
frontend/dist/

# ─── Misc ───────────────────────────────────────────────────
.cache/
*.tgz
*.zip
